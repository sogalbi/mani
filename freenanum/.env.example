# Supabase project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-PUBLISHABLE-OR-ANON-KEY
# Public site address (used for share links and OG tags)
NEXT_PUBLIC_SITE_URL=https://freenanum.example.com
# Show the "카카오로 시작하기" button (enable the Kakao provider in Supabase first)
NEXT_PUBLIC_ENABLE_KAKAO=0
