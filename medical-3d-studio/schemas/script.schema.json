{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "script",
  "type": "object",
  "required": [
    "topic_id",
    "script_version",
    "duration_sec",
    "lines"
  ],
  "properties": {
    "duration_sec": {
      "type": "number"
    },
    "voice": {
      "type": "object"
    },
    "lines": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "line_id",
          "shot_id",
          "start",
          "end",
          "claim_ids",
          "narration"
        ],
        "properties": {
          "line_id": {
            "type": "string"
          },
          "start": {
            "type": "number"
          },
          "end": {
            "type": "number"
          },
          "claim_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "narration": {
            "type": "string"
          },
          "captions": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "start",
                "end",
                "text"
              ]
            }
          }
        }
      }
    }
  }
}